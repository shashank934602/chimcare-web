# Leave DATABASE_URL unset to run against the embedded PGlite database (auto-seeded with the Minnesota test data).
# Point it at Supabase (pooler URL, transaction mode) to run against Postgres; then run `npm run seed` once.
# DATABASE_URL=postgresql://user:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: persist the embedded database between restarts instead of re-seeding into memory.
# PGLITE_DATA_DIR=.pglite

# Base URL used for canonical links and JSON-LD @ids.
SITE_URL=https://www.chimcare.com

# Booking adapter: mock (default) stores the request and returns a fake job id; workiz is a stub until the API contract is known.
# BOOKING_ADAPTER=mock
# WORKIZ_API_TOKEN=

# Protects /admin/bookings/ and GET /api/bookings/ when NODE_ENV=production (open in `npm run dev`).
# ADMIN_TOKEN=
